# Copy to .env for local dev (running `npm run dev` here + `npm run dev` in
# server/, as two separate processes on different ports — Vite on 5173, backend on
# 3000). Not a secret — Vite env vars are always bundled into the public JS the
# browser downloads, by design — but kept out of git anyway for consistency with the
# server/ .env pattern and because the right value differs per environment.
#
# Leave unset (or empty string) for the Docker/production build: nginx (Task 0.5)
# serves the built frontend and proxies /api/* to the backend under one origin, so
# relative paths ("/api/...") already resolve correctly with no base URL needed.
VITE_API_BASE_URL=http://localhost:3000
