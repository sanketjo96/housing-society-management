# Read by `docker compose` itself to fill in ${VAR} placeholders in docker-compose.yml
# (the postgres service's own credentials, and to build backend's DATABASE_URL).
# Copy to .env and fill in real values before running `docker compose up`.
# This is a DIFFERENT file from server/.env — see docs/docker-compose.md, "Env vars".

POSTGRES_USER=smi
POSTGRES_PASSWORD=changeme
POSTGRES_DB=smi_dev

# Signs JWT access tokens (Task 2.2), passed through to the backend container. Generate
# your own random value, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=changeme

# Whether the refresh-token cookie gets the Secure attribute. Leave false until real
# HTTPS exists (Task 10.2) — flip to true then, not before.
COOKIE_SECURE=false

# Gates POST /api/platform/societies (docs/society-onboarding/ Phase A) — creates a
# brand-new Society + its first ADMIN. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Held only by whoever runs onboarding — never issued to a client.
PLATFORM_BOOTSTRAP_SECRET=changeme
