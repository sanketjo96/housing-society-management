# Read by `docker compose` itself to fill in ${VAR} placeholders in docker-compose.yml
# (the postgres service's own credentials, and to build backend's DATABASE_URL).
# Copy to .env and fill in real values before running `docker compose up`.
# This is a DIFFERENT file from server/.env — see docs/docker-compose.md, "Env vars".

POSTGRES_USER=smi
POSTGRES_PASSWORD=changeme
POSTGRES_DB=smi_dev

# Signs JWT access tokens (Task 2.2), passed through to the backend container. Generate
# your own random value, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=changeme

# Whether the refresh-token cookie gets the Secure attribute. Leave false until real
# HTTPS exists (Task 10.2, scripts/enable-https.sh) — flip to true then, not before.
COOKIE_SECURE=false

# Gates POST /api/platform/societies (docs/society-onboarding/ Phase A) — creates a
# brand-new Society + its first ADMIN. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Held only by whoever runs onboarding — never issued to a client.
PLATFORM_BOOTSTRAP_SECRET=changeme

# Task 10.2 (scripts/enable-https.sh): the FQDN this VPS is reachable at. Doesn't
# need to be a purchased domain — a free dynamic-DNS hostname (DuckDNS, No-IP, etc.)
# pointed at this VPS's public IP works identically for Let's Encrypt. Leave both
# blank to stay on plain HTTP (no cert will ever be requested). See DEPLOY.md.
DOMAIN=
# Let's Encrypt only uses this for renewal/expiry notices, never for anything
# resident-facing.
CERTBOT_EMAIL=

# Operational kill switch for the WhatsApp notification channel (docs/notification/)
# specifically — 'false' stops new WHATSAPP-channel notifications from being queued
# and stops the delivery sweep from retrying any already-queued ones, e.g. while
# WHATSAPP_ACCESS_TOKEN (set elsewhere in this file / passed to the backend
# container) is missing or expired. The Email channel is unaffected either way.
# Defaults to 'true' (unset behaves exactly as if this var didn't exist).
WHATSAPP_ENABLED=true
