# Used when running the backend directly on the host (npm run dev, npm test, or the
# Prisma CLI), outside Docker. Copy to .env and fill in real values.
# This is a DIFFERENT file from the root .env — see docs/docker-compose.md, "Env vars".
#
# Inside Docker, DATABASE_URL is set directly by docker-compose.yml's `environment:`
# block instead (pointing at the `postgres` service name, not localhost) — this file
# doesn't apply there.

# Must match the root .env's POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB if you're
# pointing at the same Postgres instance the Docker Compose stack uses.
DATABASE_URL="postgresql://smi:changeme@localhost:5432/smi_dev?schema=public"

# Port the Express server listens on when run via `npm run dev` / `npm start`.
# Optional — defaults to 3000 if unset (see src/server.ts).
PORT=3000

# Signs JWT access tokens (Task 2.2). Generate your own random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse the same value across environments; never commit a real one.
JWT_ACCESS_SECRET=changeme

# Only matters running server/ and client/ as separate dev processes (different
# ports) — lets the browser send/receive the httpOnly refresh-token cookie
# cross-origin. Irrelevant in Docker/production (nginx serves both same-origin).
CORS_ORIGIN=http://localhost:5173

# Whether the refresh-token cookie gets the Secure attribute (browsers refuse to send
# Secure cookies over plain HTTP). Leave false until real HTTPS exists (Task 10.2)
# — flip to true then, not before.
COOKIE_SECURE=false
