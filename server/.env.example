# Used when running the backend directly on the host (npm run dev, npm test, or the
# Prisma CLI), outside Docker. Copy to .env and fill in real values.
# This is a DIFFERENT file from the root .env — see docs/docker-compose.md, "Env vars".
#
# Inside Docker, DATABASE_URL is set directly by docker-compose.yml's `environment:`
# block instead (pointing at the `postgres` service name, not localhost) — this file
# doesn't apply there.

# Point this at a database name DIFFERENT from the root .env's POSTGRES_DB (e.g.
# smi_test vs. smi_dev) — same Postgres instance/container is fine (this file's
# POSTGRES_USER/PASSWORD should still match the root .env's), but a different
# database. This file drives `npm test` as well as `npm run dev`, and until
# 2026-08-21 this example pointed at the same DB name the deployed app itself
# uses — meaning anyone following this example verbatim ran the full test suite
# directly against production/pilot data with no isolation at all. Create it once:
#   docker compose exec postgres psql -U smi -d smi_dev -c "CREATE DATABASE smi_test OWNER smi;"
#   DATABASE_URL="postgresql://smi:smi_dev_password@localhost:5432/smi_test?schema=public" npx prisma migrate deploy
DATABASE_URL="postgresql://smi:changeme@localhost:5432/smi_test?schema=public"

# Port the Express server listens on when run via `npm run dev` / `npm start`.
# Optional — defaults to 3000 if unset (see src/server.ts).
PORT=3000

# Signs JWT access tokens (Task 2.2). Generate your own random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse the same value across environments; never commit a real one.
JWT_ACCESS_SECRET=changeme

# Only matters running server/ and client/ as separate dev processes (different
# ports) — lets the browser send/receive the httpOnly refresh-token cookie
# cross-origin. Irrelevant in Docker/production (nginx serves both same-origin).
CORS_ORIGIN=http://localhost:5173

# Whether the refresh-token cookie gets the Secure attribute (browsers refuse to send
# Secure cookies over plain HTTP). Leave false until real HTTPS exists (Task 10.2)
# — flip to true then, not before.
COOKIE_SECURE=false

# Gates POST /api/platform/societies (docs/society-onboarding/ Phase A) — creates a
# brand-new Society + its first ADMIN user. Not a JWT-protected endpoint (no admin
# account exists yet for the society being created), so this shared secret is the
# only thing standing between this endpoint and the internet. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Held only by whoever runs onboarding (concierge action, no admin UI in v1) — never
# issued to a client, never reused across environments.
PLATFORM_BOOTSTRAP_SECRET=changeme

# Task 6.2/6.3's payment-proof storage backend (src/lib/storage). 'local' is the only
# implemented adapter — writes under LOCAL_STORAGE_DIR. Optional: defaults to 'local'
# / './uploads' if unset. See docs/payments.md for the adapter contract and how to add
# a new provider (e.g. 's3', 'gdrive') later.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./uploads

# Phase 7's swappable EmailProvider (src/lib/email). Optional: defaults to 'console'
# (logs the reset link instead of sending — see src/services/password-reset.service.ts)
# if unset, which is what `npm test`/`npm run dev` should normally leave it as. Set to
# 'resend' + the two vars below only if you need to exercise a real send locally.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=
# Used to build the /reset-password link emailed to residents. Defaults to
# http://localhost if unset.
APP_BASE_URL=http://localhost:5173

# Notification feature (docs/notification/), Phase 1: WhatsApp only, via the Meta
# Cloud API — see whatsapp.config.ts. Only read lazily, at delivery time (the
# node-cron sweep in notification-delivery.job.ts), not at server startup — leaving
# these unset doesn't block the app, it just leaves queued notifications FAILED with
# a clear error until filled in. All three WhatsApp templates
# (maintenance_bill_generated, deposit_payment_approved, credit_payment_approved)
# must also be submitted to and approved by Meta before real sends will succeed
# (requirements.md §5).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# TEMPORARY, for manual end-to-end testing only: when 'true', every outgoing
# notification sends Meta's pre-approved hello_world sample template instead of the
# real per-event template — lets the pipeline be proven with a real delivery before
# maintenance_bill_generated/deposit_payment_approved/credit_payment_approved are
# approved. Leave unset/false once those are approved (see whatsapp.service.ts).
WHATSAPP_TEST_MODE=false

# Observability Stage 1 (docs/observablity/) — structured logging via Pino. Both
# optional. LOG_LEVEL defaults to 'info' if unset (pino level names: trace/debug/
# info/warn/error/fatal). SERVICE_NAME defaults to 'smi-server' if unset — the
# `service` field stamped on every log line (src/infrastructure/observability/logger.ts).
# No SENTRY_DSN yet — error aggregation (Stage 2) is deliberately deferred until real
# users create the trigger the roadmap calls for (docs/observablity/03-roadmap.md).
LOG_LEVEL=info
SERVICE_NAME=smi-server
