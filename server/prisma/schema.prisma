// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OWNER
  TENANT
}

// Who was billed for a given MaintenanceRecord's month. Deliberately not the same
// enum as Role (ADMIN is never a billing payer type).
enum PayerType {
  OWNER
  TENANT
}

// Shared PENDING/APPROVED/REJECTED review status — originally PaymentProof's status,
// now reused by LedgerEntry (Deposit rows) after the ledger pivot (see CLAUDE.md's
// "Pivot (2026-08-06): resident view moves to a transaction ledger").
enum ProofStatus {
  PENDING
  APPROVED
  REJECTED
}

// Only EMAIL exists this phase — WhatsApp is explicitly deferred (compliance risk,
// see CLAUDE.md out-of-scope list). Modeled as an enum now so adding a channel later
// is a one-line change, not a migration to a previously-untyped string column.
enum NotificationChannel {
  EMAIL
}

enum NotificationStatus {
  SENT
  FAILED
}

model Society {
  id      String @id @default(cuid())
  name    String
  address String

  // UPI payment address QR codes are generated against (Task 6.1). Required — a
  // society can't be onboarded without a way to actually collect payment.
  upiVpa String

  // The tenant-occupied billing multiplier (rule 1: "have this factor configurable,
  // could be 1.7x or 2x etc."). Owner-occupied always bills at 1x the flat's baseRate;
  // this only applies when payerType=TENANT. @db.Decimal(3,2) allows up to 9.99, far
  // more headroom than needed for a realistic multiplier.
  tenantRateFactor Decimal @default(1.5) @db.Decimal(3, 2)

  // Admin-configurable settings tab (2026-08-06 addendum): pre-fills the base-rate
  // field when onboarding a *new* flat. Purely a default — existing flats keep their
  // own independently-editable Flat.baseRate, so this never changes an already-set
  // flat's billing. Not used directly by calculateMonthlyRate; only tenantRateFactor
  // (above) feeds the rate calculation at the society level.
  defaultBaseRate Decimal @default(1500) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
  flats Flat[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  societyId String
  society   Society @relation(fields: [societyId], references: [id])

  ownedFlats            Flat[]               @relation("FlatOwner")
  currentTenantFlats    Flat[]               @relation("FlatCurrentTenant")
  occupancyChanges      OccupancyChange[]
  ledgerEntries         LedgerEntry[]        @relation("LedgerPayer")
  reviewedLedgerEntries LedgerEntry[]        @relation("LedgerReviewer")
  auditLogs             AuditLog[]
  billedRecords         MaintenanceRecord[]
  paymentIntents        PaymentIntent[]
  refreshTokens         RefreshToken[]
  passwordResetTokens   PasswordResetToken[]

  @@index([societyId])
}

// Enables real logout (Task 2.3) — a stateless JWT can't be revoked before its natural
// expiry, so refresh tokens are opaque random values checked against this table, not
// signed/verified JWTs. tokenHash stores a SHA-256 hash, not the raw token — same
// principle as passwordHash, though a fast hash (not bcrypt) is appropriate here since
// the token itself is already high-entropy (32 random bytes), not a low-entropy
// user-chosen secret vulnerable to brute force. revokedAt is set (not deleted) on
// logout, keeping the row as a record that this token was explicitly invalidated
// rather than merely expired.
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Task 2.4. Same opaque-random-token + hash-at-rest pattern as RefreshToken, and for
// the same reason: a reset link must be revocable/single-use, which a signed JWT can't
// do on its own. usedAt (not deleted on use) makes reuse detectable — "an expired or
// reused token is rejected" is this task's explicit requirement, so a used token must
// stay in the table as a used one, not disappear.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Flat {
  id         String   @id @default(cuid())
  wing       String
  flatNumber String
  baseRate   Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  societyId String
  society   Society @relation(fields: [societyId], references: [id])

  ownerId String
  owner   User   @relation("FlatOwner", fields: [ownerId], references: [id])

  currentTenantId String?
  currentTenant   User?   @relation("FlatCurrentTenant", fields: [currentTenantId], references: [id])

  occupancyChanges   OccupancyChange[]
  maintenanceRecords MaintenanceRecord[]
  ledgerEntries      LedgerEntry[]
  paymentIntent      PaymentIntent?

  @@unique([societyId, wing, flatNumber])
  @@index([societyId])
}

// Records a tenant's occupancy period on a flat. Absence of a row covering a given
// date means the flat was owner-occupied on that date — owner-occupied periods are
// implicit, not stored. effectiveEnd is null while the tenancy is still ongoing.
model OccupancyChange {
  id             String    @id @default(cuid())
  effectiveStart DateTime
  effectiveEnd   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  flatId String
  flat   Flat   @relation(fields: [flatId], references: [id])

  tenantId String
  tenant   User   @relation(fields: [tenantId], references: [id])

  @@index([flatId])
  @@index([tenantId])
}

// One row per flat per calendar month — always a SYSTEM ledger entry, implicitly
// "Approved" and never individually paid/unpaid (see CLAUDE.md's ledger pivot note).
// period is "YYYY-MM". dueDate is set at generation time (Task 4.2) and still drives
// escalation (lib/escalation.ts) even though there's no per-record paid state anymore.
// Unique on [flatId, period] enforces "exactly 12 records/flat/year, never duplicated"
// at the database level, backing up the idempotency Task 4.2 requires of the monthly
// generation job. Every MaintenanceRecord's amount contributes permanently to its
// flat's totalCharges — payment against the running balance is tracked separately, in
// LedgerEntry (Deposit), never by mutating a record here.
model MaintenanceRecord {
  id        String    @id @default(cuid())
  period    String
  payerType PayerType
  amount    Decimal   @db.Decimal(10, 2)
  dueDate   DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  flatId String
  flat   Flat   @relation(fields: [flatId], references: [id])

  // The SPECIFIC user billed this month — resolved once at generation time (Task
  // 4.1/4.2) from occupancy history, not re-derived later from Flat.currentTenantId.
  // currentTenantId only reflects *current* occupancy, so once a flat's tenant
  // changes again after this record's month, currentTenantId would silently point at
  // the wrong (new) tenant for this historical record. payerId is the one place every
  // later consumer (notifications, payment display, audit) should look, so the
  // majority-of-days-with-tiebreak resolution logic lives in exactly one place.
  payerId String
  payer   User   @relation(fields: [payerId], references: [id])

  @@unique([flatId, period])
  @@index([flatId])
  @@index([payerId])
}

// A resident-created Deposit row (a UPI payment, pending admin review). SYSTEM
// charges are NOT stored here — they remain MaintenanceRecord rows, always
// implicitly "Approved" (see below). Credit was removed from this system entirely
// (2026-08-07) — LedgerEntry only ever represents a Deposit now.
model LedgerEntry {
  id     String      @id @default(cuid())
  amount Decimal     @db.Decimal(10, 2)
  status ProofStatus @default(PENDING)
  note   String?

  // Opaque storage key, not a browsable URL — same StorageAdapter contract as the
  // pre-pivot PaymentProof model (src/lib/storage/types.ts). Optional — a proof
  // screenshot is not required to submit a Deposit — served only through
  // GET /api/ledger-entries/:id/file (authenticated, never public).
  fileUrl  String?
  mimeType String?

  // Admin's rejection reason (rule 7) — distinct from `note` above.
  adminNote  String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  flatId String
  flat   Flat   @relation(fields: [flatId], references: [id])

  // Always the resident who created this entry (never re-derived from Flat state).
  payerId String
  payer   User   @relation("LedgerPayer", fields: [payerId], references: [id])

  reviewedById String?
  reviewedBy   User?   @relation("LedgerReviewer", fields: [reviewedById], references: [id])

  @@index([flatId])
  @@index([status])
}

// A resident's "I intend to pay this amount" step, ahead of actually submitting a
// screenshot — see CLAUDE.md's resident-view restructure note. Deliberately just an
// amount + who + when, not a full LedgerEntry: no `status` needed since existence of
// the row IS the "open" state, and submitting a screenshot deletes it in the same
// transaction that creates the resulting LedgerEntry(DEPOSIT). One row per flat at
// most (`flatId` unique) — creating a new intent while one is open replaces it.
model PaymentIntent {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  flatId String @unique
  flat   Flat   @relation(fields: [flatId], references: [id])

  payerId String
  payer   User   @relation(fields: [payerId], references: [id])
}

// channel/recipient/status describe the send attempt itself. relatedEntityType +
// relatedEntityId are a lightweight polymorphic reference (Postgres has no native
// polymorphic FK) — a notification can be about a MaintenanceRecord (generated),
// a LedgerEntry (submitted/approved/rejected), etc. No FK constraint on purpose:
// the entity type varies per notification.
model NotificationLog {
  id                String              @id @default(cuid())
  channel           NotificationChannel
  recipient         String
  status            NotificationStatus
  relatedEntityType String
  relatedEntityId   String
  createdAt         DateTime            @default(now())

  @@index([relatedEntityType, relatedEntityId])
}

// actorId is nullable — some audited actions are system-initiated (e.g. the monthly
// generation cron, Task 4.2), not performed by any human User. entityType/entityId
// use the same lightweight polymorphic pattern as NotificationLog, for the same
// reason (audited entities vary: MaintenanceRecord, LedgerEntry, etc.).
model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  note       String?
  createdAt  DateTime @default(now())

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
}
